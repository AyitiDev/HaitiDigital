---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import Icon from '../../../components/ui/Icon.astro';
import ProposalVoteWidget from '../../../components/ui/ProposalVoteWidget.astro';
import { getProposals, getProposalBySlug } from '../../../data/proposals';
import { useUi, useProposals, getLocalizedPath, type SupportedLanguage } from '../../../i18n/utils';

export function getStaticPaths() {
  const proposals = getProposals();
  return proposals.map((proposal) => ({
    params: { lang: 'en', slug: proposal.slug },
    props: { proposal },
  }));
}

const { lang, slug } = Astro.params as { lang: SupportedLanguage; slug: string };
const proposal = Astro.props.proposal ?? getProposalBySlug(slug);

if (!proposal) {
  return Astro.redirect(getLocalizedPath('/', lang));
}

const tUi = useUi(lang);
const t = useProposals(lang);
const categoryLabel = tUi(`categories.${proposal.category}` as any, proposal.category);
const isInDevelopment = proposal.status === 'in_development';
---

<BaseLayout title={proposal.title} description={proposal.summary} lang={lang}>
  <article class="w-full py-8 sm:py-12 bg-white dark:bg-neutral-950 transition-colors duration-200 min-h-[80vh]">
    <div class="max-w-2xl mx-auto px-4 sm:px-6">

      <div class="flex items-center justify-between gap-4 mb-8">
        <a
          href={getLocalizedPath('/#catalog', lang)}
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors"
        >
          <Icon name="arrow-left" class="w-3.5 h-3.5" />
          {t('detail.back')}
        </a>
        <div class="flex items-center gap-1">
          <button
            id="detail-share-btn"
            type="button"
            class="p-2 rounded-lg text-neutral-400 dark:text-neutral-500 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer"
            aria-label={t('detail.share')}
          >
            <Icon name="share-2" class="w-4 h-4" />
          </button>
          <button
            type="button"
            class="p-2 rounded-lg text-neutral-400 dark:text-neutral-500 hover:text-neutral-900 dark:hover:text-white hover:bg-neutral-100 dark:hover:bg-neutral-800 transition-colors cursor-pointer"
            aria-label={t('detail.bookmark')}
          >
            <Icon name="bookmark" class="w-4 h-4" />
          </button>
        </div>
      </div>

      <div class="mb-3">
        <span class="text-[10px] font-bold uppercase tracking-widest text-neutral-400 dark:text-neutral-500">
          {t('detail.badgeProposal')} · {categoryLabel}
        </span>
      </div>

      <h1 class="text-2xl sm:text-3xl lg:text-4xl font-extrabold text-neutral-950 dark:text-white tracking-tight leading-[1.2] mb-5">
        {proposal.detail.leadTitle}
      </h1>

      <div class="flex items-center gap-3 pb-6 border-b border-neutral-100 dark:border-neutral-800">
        <div class="w-8 h-8 rounded-lg bg-neutral-900 dark:bg-white text-white dark:text-neutral-900 flex items-center justify-center font-black text-[10px] transition-colors">
          {tUi('site.shortName')}
        </div>
        <div>
          <div class="text-xs font-bold text-neutral-900 dark:text-white">{proposal.detail.author}</div>
          {(proposal.detail.publishDate || proposal.detail.readingTime) && (
            <div class="text-[11px] text-neutral-400 dark:text-neutral-500">
              {proposal.detail.publishDate && `${t('detail.published')} ${proposal.detail.publishDate}`}
              {proposal.detail.publishDate && proposal.detail.readingTime && ' · '}
              {proposal.detail.readingTime && `${proposal.detail.readingTime} ${t('detail.minRead')}`}
            </div>
          )}
        </div>
      </div>

      <ProposalVoteWidget
        proposalId={proposal.id}
        initialUpvotes={proposal.detail.initialUpvotes}
        initialDislikes={proposal.detail.initialDislikes}
        lang={lang}
      />

      {isInDevelopment ? (
        <div class="my-8 p-6 rounded-2xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 text-center space-y-2 transition-colors">
          <p class="text-sm font-bold text-neutral-900 dark:text-white">
            {t('detail.inDevelopment')}
          </p>
          <p class="text-xs text-neutral-500 dark:text-neutral-400 max-w-sm mx-auto">
            {t('detail.inDevelopmentSub')}
          </p>
        </div>
      ) : (
        <>
          {proposal.detail.executiveSummary && (
            <div class="my-6 pl-4 border-l-2 border-neutral-900 dark:border-white text-sm sm:text-base text-neutral-700 dark:text-neutral-300 leading-relaxed italic">
              <strong class="font-bold not-italic text-neutral-950 dark:text-white">
                {t('detail.executiveSummary')}:
              </strong>{' '}
              {proposal.detail.executiveSummary}
            </div>
          )}

          {proposal.detail.problem && (
            <section class="my-8 space-y-2">
              <h2 class="text-lg sm:text-xl font-bold text-neutral-950 dark:text-white tracking-tight">
                {t('detail.problemTitle')}
              </h2>
              <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                {proposal.detail.problem}
              </p>
            </section>
          )}

          {proposal.detail.technicalArchitecture && (
            <section class="my-8 p-5 rounded-xl border border-neutral-200 dark:border-neutral-800 bg-neutral-50 dark:bg-neutral-900 transition-colors">
              <h3 class="text-[10px] font-bold uppercase tracking-widest text-neutral-400 dark:text-neutral-500 mb-4">
                {t('detail.architectureTitle')}
              </h3>
              <ul class="space-y-3">
                {proposal.detail.technicalArchitecture.items.map((item) => (
                  <li class="flex items-start gap-2.5 text-xs sm:text-sm">
                    <Icon name="check" class="w-3.5 h-3.5 text-neutral-900 dark:text-white mt-0.5 flex-shrink-0" />
                    <div>
                      <strong class="font-bold text-neutral-900 dark:text-white">{item.label}:</strong>{' '}
                      <span class="text-neutral-600 dark:text-neutral-400">{item.value}</span>
                    </div>
                  </li>
                ))}
              </ul>
            </section>
          )}

          {proposal.detail.internationalBenchmark && (
            <section class="my-8 space-y-2">
              <h2 class="text-lg sm:text-xl font-bold text-neutral-950 dark:text-white tracking-tight">
                {t('detail.benchmarkTitle')}
              </h2>
              <p class="text-sm text-neutral-600 dark:text-neutral-400 leading-relaxed">
                {proposal.detail.internationalBenchmark}
              </p>
            </section>
          )}

          {proposal.detail.roadmap && proposal.detail.roadmap.length > 0 && (
            <section class="my-8 space-y-3">
              <h2 class="text-lg sm:text-xl font-bold text-neutral-950 dark:text-white tracking-tight">
                {t('detail.roadmapTitle')}
              </h2>
              <div class="space-y-2">
                {proposal.detail.roadmap.map((phase, idx) => (
                  <div class="p-4 rounded-xl border border-neutral-100 dark:border-neutral-800 bg-white dark:bg-neutral-900/50 flex flex-col sm:flex-row sm:items-baseline gap-1 sm:gap-3 transition-colors">
                    <span class="text-xs font-bold text-neutral-900 dark:text-white whitespace-nowrap">
                      {idx + 1}. {phase.phase} ({phase.duration})
                    </span>
                    <span class="text-xs text-neutral-500 dark:text-neutral-400 leading-relaxed">
                      {phase.description}
                    </span>
                  </div>
                ))}
              </div>
            </section>
          )}
        </>
      )}

      <div class="pt-6 border-t border-neutral-100 dark:border-neutral-800">
        <a
          href={getLocalizedPath('/#catalog', lang)}
          class="inline-flex items-center gap-1.5 text-xs font-semibold text-neutral-500 dark:text-neutral-400 hover:text-neutral-900 dark:hover:text-white transition-colors"
        >
          <Icon name="arrow-left" class="w-3.5 h-3.5" />
          {t('detail.back')}
        </a>
      </div>

    </div>
  </article>
</BaseLayout>

<script>
  document.getElementById('detail-share-btn')?.addEventListener('click', async () => {
    if (navigator.share) {
      try { await navigator.share({ title: document.title, url: window.location.href }); } catch {}
    } else {
      await navigator.clipboard.writeText(window.location.href);
    }
  });
</script>
