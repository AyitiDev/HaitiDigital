---
import { useUi, type SupportedLanguage } from '../../i18n/utils';

interface Props {
  lang?: SupportedLanguage;
}

const { lang = 'en' } = Astro.props;
const t = useUi(lang);

const steps = [
  { number: t('approach.step1.number'), title: t('approach.step1.title'), description: t('approach.step1.description') },
  { number: t('approach.step2.number'), title: t('approach.step2.title'), description: t('approach.step2.description') },
  { number: t('approach.step3.number'), title: t('approach.step3.title'), description: t('approach.step3.description') },
  { number: t('approach.step4.number'), title: t('approach.step4.title'), description: t('approach.step4.description') },
];
---

<section id="approach" class="w-full py-14 sm:py-20 border-t border-neutral-100 dark:border-neutral-800 bg-neutral-50/40 dark:bg-neutral-900/30 transition-colors duration-200">
  <div class="max-w-6xl mx-auto px-4 sm:px-6">

    <h2 class="text-2xl sm:text-3xl font-extrabold text-neutral-950 dark:text-white tracking-tight mb-10 sm:mb-14">
      {t('approach.title')}
    </h2>

    <div class="grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-4 gap-8">
      {steps.map((step) => (
        <div class="flex flex-col gap-2">
          <span class="text-xs font-black tracking-widest text-neutral-300 dark:text-neutral-600">
            {step.number}
          </span>
          <h3 class="text-base font-bold text-neutral-900 dark:text-white">
            {step.title}
          </h3>
          <p class="text-xs sm:text-sm text-neutral-500 dark:text-neutral-400 leading-relaxed">
            {step.description}
          </p>
        </div>
      ))}
    </div>

  </div>
</section>
